<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Course List (Tree) View -->
    <record id="view_student_course_list" model="ir.ui.view">
        <field name="name">student.course.list</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="code"/>
                <field name="duration"/>
                <field name="fee" widget="monetary"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Course Form View -->
    <record id="view_student_course_form" model="ir.ui.view">
        <field name="name">student.course.form</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Computer Science"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="fee"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="short_description"/>
                    </group>
                    <notebook>
                        <page string="Modules" name="modules">
                            <field name="module_ids" context="{'active_test': False}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Enter full course description here..."/>
                        </page>
                        <page string="Enrollments" name="enrollments">
                            <field name="enrollment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="state" widget="badge" decoration-info="state == 'enrolled'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'"/>
                                    <field name="progress_percentage" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Course Search View -->
    <record id="view_student_course_search" model="ir.ui.view">
        <field name="name">student.course.search</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>
</odoo>
