<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quiz Question List View -->
    <record id="view_student_quiz_question_list" model="ir.ui.view">
        <field name="name">student.quiz.question.list</field>
        <field name="model">student.quiz.question</field>
        <field name="arch" type="xml">
            <list string="Quiz Questions">
                <field name="sequence" widget="handle"/>
                <field name="module_id"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Quiz Question Form View -->
    <record id="view_student_quiz_question_form" model="ir.ui.view">
        <field name="name">student.quiz.question.form</field>
        <field name="model">student.quiz.question</field>
        <field name="arch" type="xml">
            <form string="Quiz Question">
                <sheet>
                    <group>
                        <group>
                            <field name="module_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="name" string="Question Text"/>
                    </group>
                    <notebook>
                        <page string="Options" name="options">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="is_correct" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Quiz Question Search View -->
    <record id="view_student_quiz_question_search" model="ir.ui.view">
        <field name="name">student.quiz.question.search</field>
        <field name="model">student.quiz.question</field>
        <field name="arch" type="xml">
            <search string="Search Questions">
                <field name="name"/>
                <field name="module_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Module" name="group_by_module" context="{'group_by':'module_id'}"/> 
                </group>
            </search>
        </field>
    </record>
</odoo>
