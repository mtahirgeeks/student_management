<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance List View -->
    <record id="view_student_attendance_list" model="ir.ui.view">
        <field name="name">student.attendance.list</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" editable="top">
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <!-- Attendance Form View -->
    <record id="view_student_attendance_form" model="ir.ui.view">
        <field name="name">student.attendance.form</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance Record">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="course_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="state" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                    <group string="Remarks">
                        <field name="remarks" placeholder="Add any comments or reasons here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attendance Search View -->
    <record id="view_student_attendance_search" model="ir.ui.view">
        <field name="name">student.attendance.search</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="student_id"/>
                <field name="course_id"/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Absent" name="absent" domain="[('state', '=', 'absent')]"/>
                <filter string="Present" name="present" domain="[('state', '=', 'present')]"/>
                <filter string="Late" name="late" domain="[('state', '=', 'late')]"/>
                <filter string="Excused" name="excused" domain="[('state', '=', 'excused')]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:day'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Attendance Window Action -->
    <record id="action_student_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">student.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_student_attendance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record student attendance!
            </p>
        </field>
    </record>
</odoo>
