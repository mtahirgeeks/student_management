<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Student Number -->
        <record id="seq_student_roll_number" model="ir.sequence">
            <field name="name">Student Roll Number</field>
            <field name="code">student.student</field>
            <field name="prefix">STU</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Course Code -->
        <record id="seq_course_code" model="ir.sequence">
            <field name="name">Course Code</field>
            <field name="code">student.course</field>
            <field name="prefix">COURSE</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Enrollment Number -->
        <record id="seq_enrollment_number" model="ir.sequence">
            <field name="name">Enrollment Number</field>
            <field name="code">student.enrollment</field>
            <field name="prefix">ENR</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Quiz Attempt Number -->
        <record id="seq_quiz_attempt_number" model="ir.sequence">
            <field name="name">Quiz Attempt Number</field>
            <field name="code">student.quiz.attempt</field>
            <field name="prefix">ATT</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
